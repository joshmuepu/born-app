{
  "name": "born",
  "productName": "Branham or Nothing",
  "version": "1.0.5",
  "description": "BORN — Branham or Nothing: sermon quote search and projection tool",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "npm rebuild better-sqlite3 && vitest run; npm run rebuild:native",
    "test:watch": "npm rebuild better-sqlite3 && vitest; npm run rebuild:native",
    "_run-build-script": "node -e \"const v=+process.versions.node.split('.')[0];process.exit(v>=23?1:0)\"",
    "build:db": "esbuild scripts/build-sermon-db.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.build-sermon-db.mjs && (npm run -s _run-build-script && node scripts/.build-sermon-db.mjs || ELECTRON_RUN_AS_NODE=1 electron scripts/.build-sermon-db.mjs)",
    "prepare:songs": "mkdir -p resources/songs-source && unzip -o -q Songs.zip -d resources/songs-source",
    "build:library": "npm run prepare:songs && esbuild scripts/build-library-db.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.build-library-db.mjs && (npm run -s _run-build-script && node scripts/.build-library-db.mjs || ELECTRON_RUN_AS_NODE=1 electron scripts/.build-library-db.mjs)",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist": "electron-vite build && electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.joshmuepu.born",
    "productName": "Branham or Nothing",
    "directories": {
      "output": "dist-installers"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "resources/",
        "to": "",
        "filter": [
          "sermons.db.gz",
          "library.db.gz"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icons/icon.icns",
      "artifactName": "BORN-${version}-macOS-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "artifactName": "BORN-${version}-Windows-Setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/",
      "category": "Utility",
      "artifactName": "BORN-${version}-Linux-x86_64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "fast-xml-parser": "^5.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^4.0.18",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.0.18"
  }
}
